{
  "name": "alcaldia-tramites-corte-vertical",
  "version": "1.0.0",
  "description": "Corte vertical ejecutable para el sistema de trámites y certificados de la Alcaldía Municipal (Caso 2 - DAS)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "cross-env NODE_ENV=test DB_DIALECT=sqlite jest --runInBand --detectOpenHandles --forceExit"
  },
  "keywords": [
    "arquitectura-software",
    "c4-model",
    "corte-vertical",
    "arc42",
    "express",
    "sequelize",
    "postgresql"
  ],
  "author": "Equipo de Arquitectura de Software",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "sqlite3": "^5.1.7",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}

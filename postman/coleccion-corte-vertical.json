{
  "info": {
    "_postman_id": "c7a84e31-89b2-4d2c-9a1b-3ef1a7298642",
    "name": "Alcaldía Municipal - Corte Vertical Trámites y Certificados",
    "description": "Colección oficial de pruebas de arquitectura y corte vertical para el Caso 2 (Alcaldía Municipal) según el DAS arc42 + C4.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000/api", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "solicitud_id", "value": "", "type": "string" },
    { "key": "radicado_creado", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. POST /api/auth/login - 200 y devuelve token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code es 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Devuelve token JWT y usuario', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('token');",
              "    pm.expect(jsonData).to.have.property('usuario');",
              "    pm.collectionVariables.set('token', jsonData.token);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"funcionario@alcaldia.gov.co\",\n  \"password\": \"Alcaldia2026*\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/login",
          "host": ["{{base_url}}"],
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "2. POST /api/solicitudes sin token - 401 (Valida AC-01 Seguridad)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Rechaza peticion sin token con status 401', function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "pm.test('Retorna error de token faltante', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('error');",
              "    pm.expect(jsonData.codigo).to.eql('AUTH_TOKEN_MISSING');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tipoTramiteId\": 1,\n  \"direccionPredio\": \"Calle 100 # 20 - 15\",\n  \"barrioVereda\": \"La Esperanza\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/solicitudes",
          "host": ["{{base_url}}"],
          "path": ["solicitudes"]
        }
      }
    },
    {
      "name": "3. POST /api/solicitudes con token - 201 Radicada",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code es 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('Retorna objeto solicitud con radicado oficial', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('solicitud');",
              "    pm.expect(jsonData.solicitud).to.have.property('id');",
              "    pm.expect(jsonData.solicitud).to.have.property('radicado');",
              "    pm.expect(jsonData.solicitud.activo).to.eql(true);",
              "    pm.collectionVariables.set('solicitud_id', jsonData.solicitud.id);",
              "    pm.collectionVariables.set('radicado_creado', jsonData.solicitud.radicado);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tipoTramiteId\": 1,\n  \"direccionPredio\": \"Avenida Bolivar # 45 - 12\",\n  \"barrioVereda\": \"El Carmen\",\n  \"observaciones\": \"Radicacion ciudadana 24/7 sin filas\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/solicitudes",
          "host": ["{{base_url}}"],
          "path": ["solicitudes"]
        }
      }
    },
    {
      "name": "4. POST /api/solicitudes predio duplicado - 409 (Regla de negocio)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code es 409 Conflict', function () {",
              "    pm.response.to.have.status(409);",
              "});",
              "pm.test('Retorna mensaje de conflicto por duplicidad de predio activo', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('error');",
              "    pm.expect(jsonData).to.have.property('radicadoExistente');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tipoTramiteId\": 1,\n  \"direccionPredio\": \"Avenida Bolivar # 45 - 12\",\n  \"barrioVereda\": \"El Carmen\",\n  \"observaciones\": \"Intento de radicacion duplicada\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/solicitudes",
          "host": ["{{base_url}}"],
          "path": ["solicitudes"]
        }
      }
    },
    {
      "name": "5. GET /api/solicitudes - 200 y la solicitud aparece",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code es 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('El listado incluye la solicitud previamente radicada', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(Array.isArray(jsonData)).to.be.true;",
              "    var targetId = pm.collectionVariables.get('solicitud_id');",
              "    var encontrada = jsonData.some(function(item) { return item.id == targetId; });",
              "    pm.expect(encontrada).to.be.true;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/solicitudes",
          "host": ["{{base_url}}"],
          "path": ["solicitudes"]
        }
      }
    },
    {
      "name": "6. DELETE /api/solicitudes/:id - 204 y borrado lógico",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code es 204 No Content', function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/solicitudes/{{solicitud_id}}",
          "host": ["{{base_url}}"],
          "path": ["solicitudes", "{{solicitud_id}}"]
        }
      }
    }
  ]
}
